# Local preview only. Generate both values with: openssl rand -hex 24
# Do not reuse these placeholders. The database is not published to the host.
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-24
PROXY_SHARED_SECRET=replace-with-openssl-rand-hex-24
# Public origin for links and metadata. PUBLIC_BASE_URL wins when both are set.
# This preview default keeps the Mac install on loopback. Production sets:
# PUBLIC_BASE_URL=https://spekup.com
PUBLIC_BASE_URL=http://127.0.0.1:4185
SITE_URL=http://127.0.0.1:4185
# Optional. Unset means the preview keeps working.
# ALLOWED_HOSTS=127.0.0.1:4185,localhost:4185,localhost
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Spekup <noreply@spekup.com>
# SMTP_SECURE=0
# CLAMAV_HOST=
# CLAMAV_PORT=3310
# Translation stays off until you set a provider. The Mac preview does not need these.
# LibreTranslate, after `docker compose -f docker-compose.yml -f docker-compose.translate.yml --profile translate up`:
# TRANSLATE_PROVIDER=libretranslate
# TRANSLATE_URL=http://libretranslate:5000
# TRANSLATE_API_KEY=
# An OpenAI-compatible chat endpoint instead:
# TRANSLATE_PROVIDER=openai-compatible
# TRANSLATE_URL=https://api.openai.com/v1
# TRANSLATE_API_KEY=
# TRANSLATE_MODEL=gpt-4o-mini
